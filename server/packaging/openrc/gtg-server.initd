#!/sbin/openrc-run
# OpenRC service for generic-text-gateway.
# Configuration: /etc/conf.d/gtg-server (export GTG_* variables there).

name="generic-text-gateway"
description="USB modem SMS gateway server"
command="/usr/bin/gtg-server"
command_args="run"
command_background="yes"
command_user="${GTG_USER:-gtg:gtg}"
start_stop_daemon_args="--no-new-privs"
pidfile="/run/gtg-server.pid"
output_log="/var/log/gtg-server.log"
error_log="/var/log/gtg-server.log"
rc_ulimit="${GTG_ULIMIT:--u 128 -n 512}"

depend() {
    need net
    after firewall
}

start_pre() {
    checkpath -d -m 0750 -o "${GTG_USER:-gtg:gtg}" \
        "${GTG_DATA_DIR:-/var/lib/generic-text-gateway}"
    # 0640: the log carries sender phone numbers — not world-readable.
    checkpath -f -m 0640 -o "${GTG_USER:-gtg:gtg}" "$output_log"
}
